# ==============================================================================
# Mocter · Plantilla de variables de entorno para PRODUCCIÓN
# Copiar este archivo a /opt/mocter-admin/.env en el VPS de producción.
# Permisos recomendados: deploy:deploy 600
# NUNCA versionar contraseñas reales en git (R-01).
# ==============================================================================

# Credenciales de PostgreSQL 18 (pgvector)
POSTGRES_USER=mocter_admin
POSTGRES_PASSWORD=CAMBIAR_POR_PASSWORD_SEGURO_PROD
POSTGRES_DB=mocter_prod

# URL de conexión interna entre contenedores Docker (red backend interna)
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@pg-portal:5432/${POSTGRES_DB}

# Etiqueta de la imagen que se ejecuta actualmente (gestionada por deploy.sh)
TAG=v1.0.0
