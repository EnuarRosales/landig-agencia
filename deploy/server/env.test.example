# ==============================================================================
# Mocter · Plantilla de variables de entorno para PRUEBAS (Staging proyectado)
# Copiar este archivo a /opt/mocter-admin/.env en el VPS de pruebas.
# Permisos recomendados: deploy:deploy 600
# ==============================================================================

# Credenciales de PostgreSQL 18 (pgvector)
POSTGRES_USER=mocter_test
POSTGRES_PASSWORD=CAMBIAR_POR_PASSWORD_SEGURO_TEST
POSTGRES_DB=mocter_test

# URL de conexión interna entre contenedores Docker
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@pg-portal:5432/${POSTGRES_DB}

# Dominio público para Traefik v2.11 (sslip.io sobre la IP del VPS de pruebas)
# Ejemplo para IP 1.2.3.4 -> 1-2-3-4.sslip.io
APP_DOMAIN=IP_CON_GUIONES.sslip.io

# Etiqueta de la imagen (gestionada por deploy.sh, formato sha-<commit_7>)
TAG=sha-xxxxxxx
