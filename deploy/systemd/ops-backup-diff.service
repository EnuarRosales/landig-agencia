[Unit]
Description=Mocter - Respaldo Diferencial Diario pgBackRest hacia Cloudflare R2 (OPS-001 §5)
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
User=root
ExecStart=/usr/bin/docker exec pg-portal pgbackrest-secure --stanza=pg-portal --type=diff backup
StandardOutput=journal
StandardError=journal
