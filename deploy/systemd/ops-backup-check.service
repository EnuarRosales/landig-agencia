[Unit]
Description=Mocter - Verificación Diaria de Conectividad y Archiving pgBackRest (OPS-001 §5)
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
User=root
ExecStart=/usr/bin/docker exec pg-portal pgbackrest-secure --stanza=pg-portal check
StandardOutput=journal
StandardError=journal
