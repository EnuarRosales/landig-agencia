# Plantilla raíz de variables de entorno: copiar a `.env` y completar los valores.
# La aplicación lee DATABASE_URL exclusivamente en tiempo de ejecución (inyectada por
# Docker Compose; ver docker-compose.yml / docker-compose.prod.yml o k8s/secrets.example.yaml
# para Kubernetes). Ningún archivo .env se incluye en la imagen Docker.

# Versión admitida de PostgreSQL: 18+ (con extensión pgvector).
# Esquema de conexión: postgres://<usuario>:<contraseña>@<host>:<puerto>/<base_de_datos>

POSTGRES_USER=
POSTGRES_PASSWORD=
# El nombre del host debe ser el mismo que se le asigne al servicio en el 'docker-compose.yml'
# Por temas de resolución DNS de Docker el nombre debe ser unico entre todos los sevicios
# que existan en la instancia Docker y por estandarización se debe nombrar iniciando por 'pg-namexxx'
POSTGRES_HOST=postgres
# Si cambia el port por defecto de PostgreSQL ajuste dicho atributo en la DATABASE_URL
# quemando el port '5432'
POSTGRES_PORT=5432
# Se define por estandarización que el nombre inicie por 'db-namexxx'.
POSTGRES_DB=

DATABASE_URL=postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# Variables para Redis
REDIS_PASSWORD=

# Variables para autenticación y rate limiting (AUTH-001)
AUTH_RATE_LIMIT_PEPPER=mocter-dev-pepper
ALLOWED_ORIGINS=http://localhost:3001,http://127.0.0.1:3001

# Proveedor Google OIDC (AUTH-001 §5.3, T-05, T-14)
# Redirect URI requerida: https://<dominio>/auth/google/callback (o http://localhost:3001/auth/google/callback en local)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3001/auth/google/callback

# Proveedor Facebook OAuth (AUTH-001 §5.3, T-05, T-15)
# Redirect URI requerida: https://<dominio>/auth/facebook/callback (o http://localhost:3001/auth/facebook/callback en local)
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_REDIRECT_URI=http://localhost:3001/auth/facebook/callback

# Chatwoot SSO (AUTH-001 §5.10, T-05, T-33)
CHATWOOT_SSO_SECRET=

# Cifrado TOTP 2FA (AUTH-001 §4.1, T-17)
# En producción la clave vive en /run/secrets/totp_key_<id> (32 bytes base64)
TOTP_ACTIVE_KEY_ID=k1
TOTP_SECRETS_DIR=/run/secrets

# Servicio de Correo SMTP para verificación de email y recuperación de contraseña (AUTH-001 §5.7, §5.8)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=soporte@mocter.co

# URLs públicas del portal web y portal admin
NEXT_PUBLIC_APP_URL=http://localhost:3001
NEXT_PUBLIC_SITE_URL=http://localhost:3001
NEXT_PUBLIC_API_URL=http://localhost:3001/api
NEXT_PUBLIC_ADMIN_URL=http://localhost:3003