# Root environment template: copy to `.env` and fill in.
# The app reads DATABASE_URL at runtime only (Docker compose injects it; see
# docker-compose.dev.yml / docker-compose.prod.yml; k8s/secrets.example.yaml for
# Kubernetes). No .env file is ever baked into the Docker image.

# PostgreSQL 18+ is the admissible server version.
# Schema: postgres://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=${DATABASE_URL:postgres://mocter:changeme@postgres:5432/mocter}
