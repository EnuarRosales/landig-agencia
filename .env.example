# Plantilla raíz de variables de entorno: copiar a `.env` y completar los valores.
# La aplicación lee DATABASE_URL exclusivamente en tiempo de ejecución (inyectada por
# Docker Compose; ver docker-compose.yml / docker-compose.prod.yml o k8s/secrets.example.yaml
# para Kubernetes). Ningún archivo .env se incluye en la imagen Docker.

# Versión admitida de PostgreSQL: 18+ (con extensión pgvector).
# Esquema de conexión: postgres://<usuario>:<contraseña>@<host>:<puerto>/<base_de_datos>

POSTGRES_USER=
POSTGRES_PASSWORD=
# El nombre del host debe ser el mismo que se le asigne al servicio en el 'docker-compose.yml'
# Por temas de resolución DNS de Docker el nombre debe ser unico entre todos los sevicios
# que existan en la instancia Docker y por estandarización se debe nombrar iniciando por 'pg-namexxx'
POSTGRES_HOST=postgres
# Si cambia el port por defecto de PostgreSQL ajuste dicho atributo en la DATABASE_URL
# quemando el port '5432'
POSTGRES_PORT=5432
# Se define por estandarización que el nombre inicie por 'db-namexxx'.
POSTGRES_DB=

DATABASE_URL=postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}
