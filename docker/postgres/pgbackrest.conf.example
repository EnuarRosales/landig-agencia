# ==============================================================================
# Mocter · Plantilla de configuración de pgBackRest hacia Cloudflare R2
# Especificación: OPS-001 §4.3, T-06
# Ubicación en servidor: /etc/pgbackrest/pgbackrest.conf
# Permisos en servidor: 0600 propietario postgres:postgres
# NOTA: La passphrase de cifrado vive separada en /etc/pgbackrest/cipher
# ==============================================================================

[global]
repo1-type=s3
repo1-s3-endpoint=CLOUDFLARE_ACCOUNT_ID.r2.cloudflarestorage.com
repo1-s3-bucket=mocter-backups
repo1-s3-region=auto
repo1-s3-uri-style=path
repo1-s3-key=R2_ACCESS_KEY_ID
repo1-s3-key-secret=R2_SECRET_ACCESS_KEY
repo1-path=/backups/pg-portal
repo1-cipher-type=aes-256-cbc
repo1-retention-full=2
repo1-retention-diff=7
process-max=2
log-level-file=detail
log-level-console=info
start-fast=y
compress-type=zst
compress-level=3

[pg-portal]
pg1-path=/var/lib/postgresql/data
pg1-user=postgres
