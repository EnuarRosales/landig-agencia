# ==============================================================================
# Mocter · Plantilla de configuración de PostgreSQL para soporte de WAL Archiving
# Especificación: OPS-001 §4.2, T-06
# Ubicación en servidor: fuera del repositorio, montado en /etc/postgresql/postgresql.conf
# ==============================================================================

# Conexiones y Memoria
max_connections = 100
shared_buffers = 1GB
work_mem = 16MB
maintenance_work_mem = 256MB

# Replicación y Archiving Continuo (OPS-001 §4.2)
wal_level = replica
archive_mode = on
archive_command = 'pgbackrest-secure --stanza=pg-portal archive-push %p'
archive_timeout = 60s

# Checkpoints y WAL
checkpoint_completion_target = 0.9
max_wal_size = 4GB
min_wal_size = 512MB
wal_compression = zstd

# Bitácora y Observabilidad
logging_collector = on
log_destination = 'stderr'
log_min_messages = warning
log_line_prefix = '%m [%p] %q%u@%d '
log_timezone = 'UTC'
timezone = 'UTC'
